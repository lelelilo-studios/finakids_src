# Localiza las herramientas instaladas sin sudo en el usuario (ver README, "Publicación").
# Uso: source scripts/toolchains.env
# Cada variable se puede fijar de antemano para usar otra instalación.

FINAKIDS_OPT="${FINAKIDS_OPT:-$HOME/.local/opt}"

# Rust
case ":$PATH:" in *":$HOME/.cargo/bin:"*) ;; *) PATH="$HOME/.cargo/bin:$PATH" ;; esac

# Zig (enlazador para x86_64-pc-windows-gnu con cargo-zigbuild)
if ! command -v zig >/dev/null 2>&1; then
  for d in "$FINAKIDS_OPT"/zig-*; do
    if [ -x "$d/zig" ]; then PATH="$d:$PATH"; fi
  done
fi

# JDK 17 (apksigner / keytool / sdkmanager)
if [ -z "${JAVA_HOME:-}" ] || [ ! -x "$JAVA_HOME/bin/java" ]; then
  for d in "$FINAKIDS_OPT"/jdk-17*; do
    if [ -x "$d/bin/java" ]; then JAVA_HOME="$d"; fi
  done
fi
if [ -n "${JAVA_HOME:-}" ]; then
  export JAVA_HOME
  case ":$PATH:" in *":$JAVA_HOME/bin:"*) ;; *) PATH="$JAVA_HOME/bin:$PATH" ;; esac
fi

# Android SDK + NDK
if [ -z "${ANDROID_HOME:-}" ] && [ -d "$FINAKIDS_OPT/android-sdk" ]; then
  ANDROID_HOME="$FINAKIDS_OPT/android-sdk"
fi
if [ -n "${ANDROID_HOME:-}" ]; then
  export ANDROID_HOME
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  if [ -z "${ANDROID_NDK_ROOT:-}" ] && [ -d "$ANDROID_HOME/ndk" ]; then
    # la versión más reciente instalada
    ANDROID_NDK_ROOT="$(ls -d "$ANDROID_HOME"/ndk/*/ 2>/dev/null | sort -V | tail -1 || true)"
    ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT%/}"
  fi
  if [ -n "${ANDROID_NDK_ROOT:-}" ]; then
    export ANDROID_NDK_ROOT
    export ANDROID_NDK_HOME="$ANDROID_NDK_ROOT"
  fi
  FINAKIDS_BUILD_TOOLS="$(ls -d "$ANDROID_HOME"/build-tools/*/ 2>/dev/null | sort -V | tail -1 || true)"
  FINAKIDS_BUILD_TOOLS="${FINAKIDS_BUILD_TOOLS%/}"
  export FINAKIDS_BUILD_TOOLS
fi

export PATH
